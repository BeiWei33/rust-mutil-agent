# 环境变量配置文件模板
# 复制此文件为 .env 并填入实际值

# ============================================================
# LLM 配置
# ============================================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# OpenAI API Base URL（可选，默认 https://api.openai.com/v1）
# 用于兼容 OpenAI 格式的其他 API（如 Azure、本地 vLLM 等）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型（可选）
OPENAI_MODEL=gpt-4o

# 默认模型（兼容旧配置；OPENAI_MODEL 未设置时使用）
DEFAULT_MODEL=gpt-4o

# Planner LLM 规划（默认关闭；开启后仍会校验 JSON plan）
# PLANNER_USE_LLM=false
# PLANNER_LLM_PROVIDER=deepseek
# PLANNER_LLM_RETRIES=1

# DeepSeek OpenAI-compatible 配置（可选）
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-pro

# ============================================================
# Anthropic Claude 配置（可选）
# ============================================================

# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================
# 本地模型配置（可选，使用 llama.cpp）
# ============================================================

# LOCAL_MODEL_PATH=/path/to/model.gguf

# ============================================================
# 搜索引擎 API（可选）
# ============================================================

# SERPAPI_KEY=your-serpapi-key
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CSE_ID=your-cse-id

# ============================================================
# 应用配置
# ============================================================

# 日志级别：trace / debug / info / warn / error
RUST_LOG=info

# SQLite 持久化路径（不设置时使用默认文件名）
# TASK_DB_PATH=rust-mutil-agent-tasks.sqlite3
# CHAT_DB_PATH=rust-mutil-agent-chat.sqlite3
# COMMAND_DB_PATH=rust-mutil-agent-commands.sqlite3
# APPROVAL_DB_PATH=rust-mutil-agent-approvals.sqlite3
# PATCH_DB_PATH=rust-mutil-agent-patches.sqlite3

# 补丁验证失败默认自动回滚策略（默认关闭；可在单次应用请求中覆盖）
# PATCH_AUTO_ROLLBACK_ON_VERIFICATION_FAILURE=false
